# Copy to .env.local. Never commit credentials.
BETTER_AUTH_URL=http://localhost:3011
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgresql://finbridge_app:CHANGE_ME@127.0.0.1:5434/finbridge_auth
# Isolated database only; never point this at the app or Render database.
AUTH_TEST_DATABASE_URL=postgresql://finbridge_app:CHANGE_ME@127.0.0.1:5434/finbridge_auth_test
# Local development only: messages saved under .local/mail-outbox, never emailed.
AUTH_EMAIL_MODE=local
# Production: unset AUTH_EMAIL_MODE and supply all SMTP settings (TLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Recommended for Render free: HTTPS transactional email API.
# Set AUTH_EMAIL_MODE=brevo, then fill these with a server-only API key and
# a sender email registered and verified in Brevo.
BREVO_API_KEY=
AUTH_EMAIL_FROM=
