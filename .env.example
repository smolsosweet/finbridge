# Copy to .env.local. Never commit credentials.
BETTER_AUTH_URL=http://localhost:3011
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgresql://finbridge_app:CHANGE_ME@127.0.0.1:5434/finbridge_auth
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite.
GEMINI_TRANSACTION_MODEL=gemini-3.5-flash-lite
# Server-side generation deadlines; the application caps these values.
GEMINI_CHAT_TIMEOUT_MS=20000
GEMINI_OCR_TIMEOUT_MS=50000
GEMINI_AUDIO_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_TIMEOUT_MS=18000
# AI requests require a verified signed-in account, including local demo mode.
# Demo profile based on AI Studio limits reported 2026-10-19: 15 RPM / 500 RPD.
# Recheck the production project's limits before use. Missing global values block AI (503).
AI_QUOTA_SERVER_DAILY_POINTS=300
AI_QUOTA_SERVER_DAILY_REQUESTS=300
AI_QUOTA_SERVER_MINUTE_REQUESTS=6
# Shared by all AI routes. Day resets at midnight America/Los_Angeles (handles DST).
AI_QUOTA_USER_DAILY_POINTS=60
AI_QUOTA_USER_MINUTE_POINTS=6
AI_QUOTA_COOLDOWN_SECONDS=60
# Isolated database only; never point this at the app or Render database.
AUTH_TEST_DATABASE_URL=postgresql://finbridge_app:CHANGE_ME@127.0.0.1:5434/finbridge_auth_test
# Local development only: messages saved under .local/mail-outbox, never emailed.
AUTH_EMAIL_MODE=local
# Production: unset AUTH_EMAIL_MODE and supply all SMTP settings (TLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Recommended for Render free: HTTPS transactional email API.
# Set AUTH_EMAIL_MODE=brevo, then fill these with a server-only API key and
# a sender email registered and verified in Brevo.
BREVO_API_KEY=
AUTH_EMAIL_FROM=
# External scheduler (GitHub Actions; email stays disabled until end-to-end checked).
SAFETY_EMAIL_ENABLED=false
SAFETY_CRON_SECRET=
# Used by scripts/invoke-safety-scheduler.mjs / GitHub repository variable.
# FINBRIDGE_BASE_URL=https://finbridge-orcin-phi.vercel.app
# Demo provisioner uses a separate explicit target and exact apply confirmations.
# DEMO_DATABASE_URL=
# Optional: true enables clearly labelled test transfers (never real payments).
# Development defaults to enabled; production defaults to disabled.
# FINBRIDGE_ENABLE_TRANSFER_SANDBOX=true
