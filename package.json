{
  "name": "finbridge",
  "version": "0.6.1",
  "private": true,
  "description": "Multilingual personal finance workspace with wallets, budgets and AI-assisted planning",
  "author": "smolsosweet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smolsosweet/finbridge.git"
  },
  "homepage": "https://github.com/smolsosweet/finbridge",
  "bugs": {
    "url": "https://github.com/smolsosweet/finbridge/issues"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "multilingual",
    "nextjs",
    "ai",
    "fintech",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "auth:migrate": "node scripts/migrate-auth.mjs",
    "test:auth": "node --test scripts/verify-auth-unit.cjs",
    "test:onboarding": "node --test scripts/verify-onboarding.cjs scripts/verify-onboarding-form.cjs",
    "test:auth:postgres": "node --test scripts/verify-auth-postgres.mjs",
    "test:transaction-ai": "node --experimental-strip-types --test scripts/verify-transaction-ai.mjs",
    "test:scenario-planner": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-scenario-planner.mjs",
    "test:localization": "node --test scripts/verify-localization.cjs",
    "test:localization:e2e": "node scripts/verify-localization-e2e.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@google/genai": "^2.28.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.6.0",
    "next": "16.3.8",
    "nodemailer": "^10.1.0",
    "page-mascot": "^0.1.0",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
