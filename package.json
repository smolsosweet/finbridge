{
  "name": "finbridge",
  "version": "0.6.1",
  "private": true,
  "description": "Multilingual personal finance workspace with wallets, budgets and AI-assisted planning",
  "author": "smolsosweet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smolsosweet/finbridge.git"
  },
  "homepage": "https://github.com/smolsosweet/finbridge",
  "bugs": {
    "url": "https://github.com/smolsosweet/finbridge/issues"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "multilingual",
    "nextjs",
    "ai",
    "fintech",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "auth:migrate": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/migrate-auth.mjs",
    "test:auth": "node --test scripts/verify-auth-unit.cjs",
    "test:workspace": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-workspace.mjs",
    "test:calendar": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-calendar-ledger.mjs",
    "test:calendar:ui": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/verify-calendar-ledger-ui.mjs",
    "test:transfers": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-international-transfers.mjs",
    "transfers:migrate": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/migrate-transfers.mjs",
    "test:transfer-reference": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-transfer-reference.mjs",
    "test:transfer-reference:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-transfer-reference-postgres.mjs",
    "test:transfers:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-international-transfers-postgres.mjs",
    "test:transfers:ui": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/verify-international-transfers-ui.mjs",
    "test:planning": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-planning-workflows.mjs",
    "test:planning:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-planning-workflows-postgres.mjs",
    "test:bill-payments": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-bill-payments.mjs scripts/verify-fixed-expense-lifecycle.mjs",
    "test:bill-payments:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-bill-payments-postgres.mjs",
    "test:workspace:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-workspace-postgres.mjs",
    "test:safety": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-safety.mjs",
    "test:safety:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-safety-postgres.mjs",
    "test:onboarding": "node --test scripts/verify-onboarding.cjs scripts/verify-onboarding-form.cjs",
    "test:auth:postgres": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-auth-postgres.mjs",
    "test:transaction-ai": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-transaction-ai.mjs",
    "ai:quota:migrate": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/migrate-ai-quota.mjs",
    "test:ai-quota": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-ai-quota.mjs scripts/verify-ai-quota-routes.mjs",
    "test:ai-quota:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-ai-quota-postgres.mjs",
    "test:conversation": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-conversation.mjs scripts/verify-assistant-route.mjs scripts/verify-obligation-context.mjs",
    "test:chat-plan": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-chat-spending-plan.mjs scripts/verify-chat-spending-plan-ui.mjs",
    "test:production-chat": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-production-chat.mjs",
    "test:conversation:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-conversation-postgres.mjs",
    "test:ai-tools": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-ai-tools.mjs",
    "test:scenario-planner": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-scenario-planner.mjs",
    "test:proactive-alerts": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-proactive-alerts.mjs",
    "test:notification-center": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-notification-center.mjs",
    "test:notification-center:ui": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/verify-planning-notifications-ui.mjs",
    "test:localization": "node --test scripts/verify-localization.cjs",
    "test:localization:e2e": "node scripts/verify-localization-e2e.mjs",
    "test:data-safety": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-data-safety.mjs scripts/verify-persistence-routes.mjs",
    "test:feedback": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-feedback.mjs",
    "test:feedback:postgres": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs --test scripts/verify-feedback-postgres.mjs",
    "test:business:unit": "npm run test:auth && npm run test:workspace && npm run test:calendar && npm run test:transfers && npm run test:transfer-reference && npm run test:planning && npm run test:bill-payments && npm run test:safety && npm run test:onboarding && npm run test:notification-center && npm run test:localization && npm run test:data-safety && npm run test:feedback && npm run test:ai-quota",
    "test:business:postgres": "npm run test:auth:postgres && npm run test:workspace:postgres && npm run test:planning:postgres && npm run test:bill-payments:postgres && npm run test:safety:postgres && npm run test:transfers:postgres && npm run test:transfer-reference:postgres && npm run test:feedback:postgres && npm run test:ai-quota:postgres",
    "test:feedback:ui": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/verify-feedback-ui.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@google/genai": "^2.30.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.6.0",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "page-mascot": "^0.1.0",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
